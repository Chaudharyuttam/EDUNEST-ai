# EduNest AI — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── API ───────────────────────────────────────────────────────────────────────
# In development, leave this blank — Vite proxy handles /api → localhost:5000
# In production, set this to your Render.com backend URL:
VITE_API_URL=https://your-backend.onrender.com/api

# Backend only (set this in server/.env locally, or in your deployment's
# server-side environment variables; never expose it as a VITE_ variable).
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-3.5-flash
