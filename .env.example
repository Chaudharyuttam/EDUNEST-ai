# EduNest AI — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── API ───────────────────────────────────────────────────────────────────────
# In development, leave this blank — Vite proxy handles /api → localhost:5000
# In production, set this to your Render.com backend URL:
VITE_API_URL=https://your-backend.onrender.com/api
