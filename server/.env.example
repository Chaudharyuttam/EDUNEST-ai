# EduNest AI — Backend Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ⚠️  NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Primary frontend URL
CLIENT_URL=http://localhost:5173
# Additional allowed origins (comma-separated, for production)
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_secret_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/edunest

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your FREE key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
